# Copy to .env and fill in. Every value below has a default in backend/src/chat_app/config/settings.py
# except OPENAI_API_KEY.

# --- secrets ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=              # set only if GPT 5.6 Terra is served from a non-default endpoint

# --- models ---
LLM_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=64
ENRICHMENT_WORKERS=8

# --- data (compose overrides DATA_PATH to /data/stock_news.json) ---
DATA_PATH=../data/stock_news.json
# TICKERS_PATH=                 # defaults to the registry bundled in chat_app/config/tickers.json
# CLEANING_RULES_PATH=          # defaults to chat_app/ingestion/cleaning/cleaning_rules.toml
# RELEVANCE_RULES_PATH=         # defaults to chat_app/config/relevance_rules.toml

# --- vector store (compose overrides QDRANT_URL to http://qdrant:6333) ---
QDRANT_URL=http://localhost:6333
# QDRANT_LOCAL_PATH=../.qdrant   # embedded Qdrant for Docker-free runs (overrides QDRANT_URL)
QDRANT_COLLECTION=stock_news
SPARSE_MODEL=Qdrant/bm25

# --- ingestion ---
STUB_MIN_WORDS=80
NEAR_DUPLICATE_THRESHOLD=0.6
TITLE_DUPLICATE_THRESHOLD=0.8
SHINGLE_SIZE=5
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_SENTENCES=1
TOKENIZER_ENCODING=cl100k_base

# --- retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_PREFETCH_K=30
FULL_COVERAGE_MIN_ARTICLES=5

# --- API ---
CORS_ORIGINS=["http://localhost:5173"]
MAX_QUERY_CHARS=500
LOG_LEVEL=INFO

# --- evaluation (pytest -m eval only; not used when serving) ---
# EVAL_CASES_PATH=              # defaults to backend/tests/eval/cases.yaml
CLAIM_JUDGE_MODEL=gpt-5.6-terra
# CLAIM_JUDGE_TEMPERATURE=0     # only for judge models that accept it; GPT 5.6 Terra rejects it
CLAIM_JUDGE_MIN_QUOTE_CHARS=20
CLAIM_JUDGE_MAX_CONCURRENCY=8
CLAIM_JUDGE_VOTES=3            # judge calls per sentence, majority wins; must be odd
CLAIM_SUPPORT_THRESHOLD=0.8    # suite-wide mean claim support must reach this
CLAIM_SUPPORT_FLOOR=0.6        # no single case may score below this (<= threshold)
# EVAL_RECALL_K=                # recall@k depth; unset = RETRIEVAL_TOP_K (what generation sees)
EVAL_MIN_MEAN_RECALL=0.8        # mean recall over reviewed gold links must reach this
EVAL_NO_DATA_PHRASES=["no data", "no information", "no news", "none of the articles"]
EVAL_VALUATION_TERMS=["market cap", "market capitalization", "market value", "valuation", "valued at"]

# --- compose host ports ---
# UI_PORT=3000
# API_PORT=8000
# QDRANT_PORT=6333
